package-as: EZ-CDM

# ship.method nested: the repo root is the addon folder, so the zip's top folder is the
# repo itself. Files and folders starting with a dot never package.
ignore:
  - README.md
  - CONTRIBUTING.md
  - tests
  - tools

# The CurseForge changelog is this file, not the commit log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
